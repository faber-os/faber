package faber:capabilities@0.1.0;

interface digital-in {
  use types.{timestamp};
  enum pull { none, up, down }
  record settings { pull: pull, debounce-ms: u32, active-low: bool }
  /// Signal, every-message.
  record reading { t-us: timestamp, level: bool }
}

interface digital-out {
  use types.{timestamp, lease-id, command-error};
  record settings { active-low: bool, safe-level: bool, lease-ms: u32 }
  /// Signal, latest-value: the level as last set. `true` is active.
  record reading { t-us: timestamp, level: bool }
  /// One command as data, as a connector receives it (the core has checked the lease).
  variant command { set(bool) }
  /// Leased (1 s). Safe state: inactive.
  set: func(lease: lease-id, level: bool) -> result<_, command-error>;
}

interface analog-in {
  use types.{timestamp};
  record settings { rate-hz: f32, reference-volts: option<f32> }
  record reading { t-us: timestamp, fraction: f32, volts: option<f32> }
}

interface pwm-out {
  use types.{timestamp, lease-id, command-error};
  record settings { frequency-hz: f32, lease-ms: u32 }
  record reading { t-us: timestamp, duty: f32 }
  /// One command as data, as a connector receives it (the core has checked the lease and
  /// clamped the duty to 0..1).
  variant command { set-duty(f32) }
  /// Leased (1 s). Duty 0..1. Safe state: duty 0.
  set-duty: func(lease: lease-id, duty: f32) -> result<_, command-error>;
}

interface servo {
  use types.{timestamp, lease-id, command-error};
  enum safe-state { hold, release }
  record settings {
    min-angle-rad: f32,
    max-angle-rad: f32,
    pulse-min-us: u32,
    pulse-max-us: u32,
    max-speed-rad-s: option<f32>,
    safe-state: safe-state,
    lease-ms: u32,
  }
  /// The angles it may be told (the core clamps commands to them) and what it does when its lease
  /// ends (D29: hold by default).
  record info { min-angle-rad: f32, max-angle-rad: f32, safe-state: safe-state }
  /// The commanded angle; most servos give no feedback. None while it is released (no pulses).
  record reading { t-us: timestamp, angle-rad: option<f32> }
  /// One command as data, as a connector receives it (the core has checked the lease and clamped
  /// the angle). `safe`: go to the safe state the part is set up for (hold or release).
  variant command { set-angle(f32), release, safe }
  /// Leased (1 s). Safe state: hold or release, per part.
  set-angle: func(lease: lease-id, angle-rad: f32) -> result<_, command-error>;
}
